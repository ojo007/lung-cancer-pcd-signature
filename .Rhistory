inspect_survival_fields <- function(accession) {
file <- file.path(
"02_processed_data/GEO/external_validation",
accession,
paste0(accession, "_phenotype_selected.csv")
)
x <- read.csv(
file,
check.names = FALSE,
stringsAsFactors = FALSE
)
cat(
"\n============================================================\n",
accession,
"\n============================================================\n",
sep = ""
)
cat("\nALL COLUMN NAMES:\n")
print(colnames(x))
candidate_columns <- grep(
paste0(
"surv|overall|\\bos\\b|",
"death|dead|alive|vital|",
"status|follow|relapse|",
"recurrence|event|time"
),
colnames(x),
ignore.case = TRUE,
value = TRUE,
perl = TRUE
)
cat("\nPOSSIBLE SURVIVAL COLUMNS:\n")
print(candidate_columns)
if (length(candidate_columns) > 0) {
for (nm in candidate_columns) {
cat(
"\n----------------------------------------\n",
nm,
"\n----------------------------------------\n",
sep = ""
)
print(
head(
unique(x[[nm]]),
20
)
)
}
}
invisible(x)
}
inspect_survival_fields("GSE31210")
inspect_survival_fields("GSE50081")
