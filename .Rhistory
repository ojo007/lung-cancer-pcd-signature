]][
i_s36
] <-
length(
outputs_hit_s36
) >
0L
strict_components_s36[[
"n_script_hits"
]][
i_s36
] <-
length(
scripts_hit_s36
)
strict_components_s36[[
"n_output_hits"
]][
i_s36
] <-
length(
outputs_hit_s36
)
if (
length(
scripts_hit_s36
) >
0L
) {
strict_components_s36[[
"script_examples"
]][
i_s36
] <-
paste(
basename(
utils::head(
scripts_hit_s36,
5
)
),
collapse = " | "
)
}
if (
length(
outputs_hit_s36
) >
0L
) {
strict_components_s36[[
"output_examples"
]][
i_s36
] <-
paste(
utils::head(
outputs_hit_s36,
5
),
collapse = " | "
)
}
}
# ============================================================
# 6. Evidence classification
#
# "Evidence found" means the method/term appears in project
# scripts or output filenames. It does not by itself prove that
# the method produced a valid final scientific result.
# ============================================================
strict_components_s36$evidence_found <-
strict_components_s36[[
"script_hit"
]] |
strict_components_s36[[
"output_filename_hit"
]]
strict_components_s36$audit_status <-
ifelse(
strict_components_s36[[
"evidence_found"
]],
"Evidence found",
"No project evidence found"
)
cat(
"\n========================================\n",
"STRICT PROPOSAL COMPONENT AUDIT\n",
"========================================\n"
)
print(
strict_components_s36[
,
c(
"component",
"proposal_role",
"script_hit",
"output_filename_hit",
"n_script_hits",
"n_output_hits",
"audit_status"
),
drop = FALSE
],
row.names = FALSE
)
# ============================================================
# 7. Focused gap table
# ============================================================
strict_gap_audit_s36 <-
strict_components_s36[
strict_components_s36[[
"component"
]] %in%
c(
"Random Forest",
"XGBoost",
"ImmuCellAI",
"TIMER/TIMER2",
"GSEA",
"CTRP",
"pRRophetic",
"IPS"
),
,
drop = FALSE
]
cat(
"\n========================================\n",
"PROPOSAL-SPECIFIC ITEMS REQUIRING REVIEW\n",
"========================================\n"
)
print(
strict_gap_audit_s36[
,
c(
"component",
"proposal_role",
"script_hit",
"output_filename_hit",
"audit_status",
"script_examples",
"output_examples"
),
drop = FALSE
],
row.names = FALSE
)
# ============================================================
# 8. Exact sequential Cox-workflow audit
# ============================================================
cox_sequence_audit_s36 <-
data.frame(
component =
c(
"Univariate Cox",
"LASSO-Cox",
"Multivariable Cox"
),
evidence_found =
c(
any(
grepl(
"univariate_Cox",
basename(
script_files_strict_s36
),
ignore.case = TRUE
)
),
any(
grepl(
"LASSO",
basename(
script_files_strict_s36
),
ignore.case = TRUE
)
),
any(
vapply(
script_text_list_s36,
function(x_s36) {
grepl(
"multivariable|multivariate",
x_s36,
ignore.case = TRUE
) &&
grepl(
"cox",
x_s36,
ignore.case = TRUE
)
},
FUN.VALUE = logical(1)
)
)
),
same_sequential_pipeline =
c(
NA,
NA,
FALSE
),
stringsAsFactors = FALSE
)
cat(
"\n========================================\n",
"COX WORKFLOW AUDIT\n",
"========================================\n"
)
print(
cox_sequence_audit_s36,
row.names = FALSE
)
# ============================================================
# 9. Dataset substitution / limitation register
# ============================================================
dataset_method_register_s36 <-
data.frame(
planned =
c(
"Random Forest / XGBoost prognostic modelling",
"CTRP drug sensitivity",
"ImmuCellAI immune characterization",
"TIMER2 immune characterization",
"pRRophetic drug prediction",
"IPS immunotherapy surrogate",
"Exact univariate -> LASSO -> multivariable Cox sequence",
"Independent patient treatment-response validation"
),
verified_alternative =
c(
"Primary ridge-Cox MPCDS plus 70/30 LASSO-Cox sensitivity",
"PRISM pharmacogenomics plus GDSC/oncoPredict predictions",
"Multiple complementary immune deconvolution methods including CIBERSORT/xCell/quanTIseq/EPIC/TIMER where available",
"TIMER-family analysis where present in the existing immune workflow",
"oncoPredict",
"TIDE",
"Separate univariate Cox, LASSO sensitivity and clinical multivariable Cox analyses",
"Cell-line pharmacogenomics and transcriptome-derived predicted drug sensitivity"
),
final_classification =
NA_character_,
requires_decision =
TRUE,
stringsAsFactors = FALSE
)
